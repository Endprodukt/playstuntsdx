{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayStunts DX",
  "version": "0.1.0",
  "identifier": "de.endprodukt.playstuntsdx",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PlayStunts DX",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
