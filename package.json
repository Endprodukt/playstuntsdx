{
  "name": "playstunts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop:web:dev": "vite --config vite.desktop.config.ts",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "node tools/seed-hires.mjs && cargo tauri dev",
    "desktop:site-art": "node tools/fetch-upstream-site-art.mjs",
    "desktop:helper": "node tools/build-asset-helper.mjs",
    "desktop:build": "npm run desktop:helper && cargo tauri build",
    "desktop:portable": "npm run desktop:site-art && npm run desktop:build && node tools/build-portable-hires.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "python3 -m unittest discover -s tools -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "assets:check": "python3 tools/check_assets.py",
    "assets:extract": "python3 tools/extract.py",
    "replay:inspect": "node tools/replay-dataset.mjs",
    "replay:inspect:test": "node --test tools/test-replay-dataset.mjs",
    "replay:simulate": "node tools/replay-telemetry.mjs",
    "replay:file:test": "node --test tools/test-replay-file.ts",
    "replay:groundtruth": "node tools/replay-groundtruth.mjs",
    "replay:groundtruth:convert": "node tools/replay-groundtruth.mjs --convert-only",
    "replay:groundtruth:test": "node --test tools/test-replay-groundtruth.mjs",
    "physics:bb11:test": "node --test tools/test-bb11-physics.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@malvineous/opl": "1.0.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "emulators": "^8.4.2",
    "emulators-ui": "^0.73.9",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "GPL-3.0-only"
}
